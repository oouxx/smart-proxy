# mihomo-smart Docker 部署环境变量
#
# 用法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 按需修改 (端口/容器名/数据目录/时区)
#   3. 直接 docker compose up -d --build 即可 (compose 自动读取 .env)
#
# 注意: .env 含本地配置信息, 已被 .gitignore 忽略; 本 .env.example 作为模板提交。

# 宿主机映射端口 (容器内固定 8000)
MIIHOMO_SMART_PORT=8000

# 容器名
MIIHOMO_SMART_CONTAINER=mihomo-smart

# 数据挂载目录 (宿主机路径, 相对 compose 所在目录)
SMART_CONFIG_DIR=./config
SMART_DATA_DIR=./data
SMART_MODELS_DIR=./models

# 容器时区
TZ=Asia/Shanghai
